<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Shares the usage snapshot with the widget extension. The same group is in
         GrouperWidgets.entitlements and in Shared/WidgetSnapshotStore.swift. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.uk.clockmillbarn.grouper</string>
    </array>
</dict>
</plist>
